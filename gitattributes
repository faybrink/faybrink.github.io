# Normalize line endings for this repo.
# Ensures every text file uses LF consistently, regardless of what OS
# or editor last touched it — prevents whole-file "changed" diffs in
# GitHub Desktop that are just line-ending flips, not real edits.

* text=auto eol=lf

# Explicitly force LF on the file types this site actually uses
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf

# Binary files — never touch these, line-ending rules don't apply
# and treating them as text can corrupt them
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
